{
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "build",
    "moduleResolution": "node",
    "resolveJsonModule": false,
    "strict": true,
    "alwaysStrict": true,
    "isolatedModules": false,
    "target": "es2024",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "paths": {
      "src/*": [
        "src/*"
      ],
      "electron": [
        "src/electron-shim.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules/**/*",
    "VencordExtension/**/*",
    "dist/**/*",
    "scripts/**/*",
    "Vencord",
    "src/Renderer/**/*",
    "src/AppCore/Windows/**/*",
    "src/AppCore/Preloads/**/*",
    "src/AppCore/IPCManager.ts",
    "src/AppCore/APIServer.ts",
    "src/AppCore/routes/users/@me/settings-proto.ts",
    "src/AppCore/index.ts",
    "src/index.ts"
  ]
}
